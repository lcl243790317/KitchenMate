{
  "name": "kitchenmate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests *.ts *.mjs",
    "recipes:validate": "tsx scripts/validate-recipes.ts",
    "recipes:coverage": "tsx scripts/recipes-coverage.ts",
    "recipes:audit": "tsx scripts/audit-local-recipes.ts",
    "recipes:verify": "tsx scripts/verify-recipe-sources.ts",
    "recipes:verify-imports": "tsx scripts/verify-import-examples.ts",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts tests/e2e/navigation.spec.ts tests/e2e/expansion.spec.ts",
    "recipes:rebuild-open": "tsx scripts/build-open-catalog.ts --snapshots",
    "recipes:audit-ingredient-groups": "tsx scripts/audit-ingredient-groups.ts",
    "recipes:audit-ingredient-completeness": "tsx scripts/audit-ingredient-completeness.ts",
    "recipes:rebuild-wikibooks": "tsx scripts/build-wikibooks-catalog.ts",
    "recipes:audit-ingredient-semantics": "tsx scripts/audit-ingredient-semantics.ts",
    "recipes:primary-coverage": "tsx scripts/primary-recipe-coverage.ts"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.3",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
