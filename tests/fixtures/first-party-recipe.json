      "title": "炒出蓬松的鸡蛋",
      "description": "锅中加入一半油，中火加热。倒入蛋液，边缘凝固时轻推，炒至基本凝固后盛出。",
      "durationSeconds": 120,
      "image": null,
      "tips": "按实际火力与食材状态调整时间。",
      "temperature": null
    },
    {
      "stepNumber": 3,
      "title": "炒软番茄",
      "description": "加入剩余油，下番茄翻炒。加剩余盐，转中小火炒出汁；太干时可加一汤匙水。",
      "durationSeconds": 180,
      "image": null,
      "tips": "按实际火力与食材状态调整时间。",
      "temperature": null
    },
    {
      "stepNumber": 4,
      "title": "合炒出锅",
      "description": "倒回鸡蛋，轻轻翻匀至蛋液完全凝固、番茄软烂。按喜好加糖，撒葱花后关火。",
